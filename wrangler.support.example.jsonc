{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afghan-ai-support-api",
  "main": "backend/social-support-worker.js",
  "compatibility_date": "2026-11-05",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afghan-ai-support",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://REPLACE-WITH-YOUR-AFGHAN-AI-DOMAIN"
  }
}